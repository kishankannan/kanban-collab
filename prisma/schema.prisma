datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & MULTI-TIER AUTHENTICATION
// ==========================================

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?      @map("email_verified")
  image         String?
  isGuest       Boolean        @default(false) @map("is_guest")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  workspaces    Workspace[]
  activities    ActivityLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// 2. WORKSPACES, BOARDS & KANBAN ENTITIES
// ==========================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boards    Board[]

  @@map("workspaces")
}

model Board {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  title       String
  color       String        @default("#3B82F6")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]
  activities  ActivityLog[]

  @@map("boards")
}

model Column {
  id        String   @id @default(cuid())
  boardId   String   @map("board_id")
  title     String
  order     Float    // Fractional order
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId, order])
  @@map("columns")
}

model Card {
  id          String    @id @default(cuid())
  columnId    String    @map("column_id")
  title       String
  description String?   @db.Text
  order       Float     // Fractional order for O(1) drag-and-drop
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId, order])
  @@map("cards")
}

// ==========================================
// 3. COLLABORATION & AUDIT TRAILS
// ==========================================

model ActivityLog {
  id          String   @id @default(cuid())
  boardId     String   @map("board_id")
  userId      String   @map("user_id")
  actionType  String   @map("action_type") // e.g., "CARD_CREATED", "CARD_MOVED"
  entityTitle String   @map("entity_title")
  createdAt   DateTime @default(now()) @map("created_at")

  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt(sort: Desc)])
  @@map("activity_logs")
}